# The Admin/forecast service project is composed only from root GAS files.
# client_runtime is deployed independently to the clean Master Template project.
**/**
!**/*.js
!**/*.html
!appsscript.json
client_runtime/**
portal_runtime/**
# デザイン素材 (キャラの描画確認ページ・SVG・PNG) は GAS に上げない
assets/**
# Claude Code などの作業用ワークツリー (.claude/worktrees/) は GAS に上げない
.claude/**
# 新アプリ（段階1〜、別の Apps Script プロジェクト。app/.clasp.json）は中央 project に上げない
app/**
# 使わなくなったものの写し（archive/）は GAS に上げない
archive/**
